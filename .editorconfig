# EditorConfig - consistent coding style for rust-cat
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # allow trailing spaces in markdown for hard breaks

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[justfile]
indent_size = 4

[Makefile]
indent_size = 4

[*.sh]
end_of_line = lf
indent_size = 4

# Rust - 4 spaces is conventional and matches rustfmt default
[*.rs]
indent_size = 4
